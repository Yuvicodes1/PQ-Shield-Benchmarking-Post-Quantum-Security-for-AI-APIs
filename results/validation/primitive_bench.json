  "qualitative_ordering_checks": [
    {
      "claim": "ML-DSA-65 verification is faster than ML-DSA-65 signing",
      "holds": true,
      "evidence": {
        "ml_dsa_65_sign_mean_us": 120.50486000148906,
        "ml_dsa_65_verify_mean_us": 38.149460000482804,
        "sign_p99_us": 316.1500000032902,
        "sign_p99_over_median": 3.023839698052043
      },
      "rationale": "ML-DSA signing uses Fiat-Shamir with Aborts: rejection sampling means signing repeats until a norm check passes (expected ~5.1 iterations at security level 3), while verification is single-pass and deterministic.",
      "source": "FIPS 204 Sec. 6; Benchmarking ML-KEM/ML-DSA on Cortex-M0+, arXiv:2603.19340, Sec. IV-B (signing variance, deterministic verification)."
    },
    {
      "claim": "ML-KEM-768 key generation is faster than RSA-2048 key generation",
      "holds": true,
      "evidence": {
        "ml_kem_768_keygen_mean_us": 13.118025000977696,
        "rsa2048_keygen_mean_us": 62891.752799993126,
        "speedup_factor": 4794.300422152402
      },
      "rationale": "RSA keygen requires probabilistic prime search; ML-KEM keygen is deterministic-time polynomial arithmetic. This is the mechanism behind PQ-Shield's availability finding at high concurrency.",
      "source": "A Practical Performance Benchmark of Post-Quantum Cryptography Across Heterogeneous Computing Environments, Cryptography 9(1):12, 2025."
    },
    {
      "claim": "ML-DSA-65 verification is not slower than ECDSA P-256 verification (H4)",
      "holds": true,
      "evidence": {
        "ml_dsa_65_verify_mean_us": 38.149460000482804,
        "ecdsa_p256_verify_mean_us": 85.2810800000725,
        "ratio_mldsa_over_ecdsa": 0.44733790895296316
      },
      "rationale": "This is PQ-Shield's own H4. It is listed here as a primitive-level check so the application-level result can be corroborated at the algorithm level on the same host.",
      "source": "PQ-Shield docs/DESIGN.md H4; cf. Schemitt et al. (2025) on ML-DSA verification speed."
    }
  ],
